# Launcher .env template — copy to .env and fill in your cluster values.
# .env is gitignored (never committed). This is the documented shape only.
CLUSTER_NODES="<HEAD_ROCE_IP>,<WORKER_ROCE_IP>"
LOCAL_IP="<HEAD_ROCE_IP>"
ETH_IF="enp1s0f0np0"
IB_IF="rocep1s0f0,roceP2p1s0f0"
MASTER_PORT="29501"
CONTAINER_NAME="b12x-vllm-node"
CONTAINER_NCCL_DEBUG="INFO"
CONTAINER_NCCL_IGNORE_CPU_AFFINITY="1"
COPY_HOSTS="<WORKER_ROCE_IP>"
CONTAINER_RT="podman"
VLLM_SPARK_NOFILE_LIMIT=500000
# HF token (leave unset in the example; set in the real .env)
# CONTAINER_HF_TOKEN="hf_..."
